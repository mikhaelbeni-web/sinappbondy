# Firebase (client - projet public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (serveur - clé de service)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# HelloAsso (paiement en ligne, API Checkout v5)
# Identifiants du client API : HelloAsso > Mon compte > Intégrations et API
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Identifiant de l'association dans ses URL HelloAsso
# (https://www.helloasso.com/associations/<slug>)
HELLOASSO_ORGANIZATION_SLUG=
# Facultatif : https://api.helloasso-sandbox.com pour les tests
# (par défaut https://api.helloasso.com, la production)
HELLOASSO_API_URL=

# Resend (tous les e-mails : relances, reçus, lien de l'espace fidèle…)
RESEND_API_KEY=re_...
# Expéditeur, sur un domaine vérifié dans Resend > Domains.
# Sans cette variable : onboarding@resend.dev, qui n'envoie qu'à
# l'adresse du compte Resend (les autres envois sont refusés).
EMAIL_FROM="Synagogue <dons@votredomaine.com>"

# URL publique de l'appli (pour les liens de paiement et de relance)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nom de la synagogue affiché dans l'appli et les e-mails
NEXT_PUBLIC_SYNAGOGUE_NAME="Synagogue"

# Secret de signature des liens de paiement envoyés par e-mail
# (facultatif : à défaut, HELLOASSO_CLIENT_SECRET est utilisée)
PAY_LINK_SECRET=

# Relances automatiques quotidiennes (Vercel Cron, voir vercel.json) :
# chaîne aléatoire, Vercel l'envoie en en-tête Authorization
CRON_SECRET=
